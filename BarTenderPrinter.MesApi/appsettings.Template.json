{
  "ConnectionStrings": {
    "MesDatabase": "Host=${PROJECT_POSTGRES_HOST};Port=${PROJECT_POSTGRES_PORT};Database=${PROJECT_POSTGRES_DATABASE};Username=${PROJECT_POSTGRES_USERNAME};Password=${PROJECT_POSTGRES_PASSWORD}"
  },
  "MesSecurity": {
    "Sessions": [
      {
        "Token": "${PROJECT_MES_SESSION_TOKEN}",
        "UserId": "${PROJECT_MES_USER_ID}",
        "StationId": "${PROJECT_MES_STATION_ID}",
        "ShiftId": "${PROJECT_MES_SHIFT_ID}",
        "Roles": [
          "${PROJECT_MES_ROLE}"
        ]
      }
    ]
  }
}
