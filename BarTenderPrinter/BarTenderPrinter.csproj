<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BarTenderPrinter</RootNamespace>
    <AssemblyName>BarTenderPrinter</AssemblyName>
    <Version>5.7.85</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- Self-contained installed application -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Optimizations -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarTenderPrinter.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <PreviewHostProject>$(MSBuildProjectDirectory)/../BarTenderPreviewHost/BarTenderPreviewHost.csproj</PreviewHostProject>
    <PreviewHostOutput>$(MSBuildProjectDirectory)/../BarTenderPreviewHost/bin/$(Configuration)/net48</PreviewHostOutput>
  </PropertyGroup>

  <Target Name="BuildPreviewHost" BeforeTargets="Build">
    <MSBuild Projects="$(PreviewHostProject)" Targets="Restore;Build" Properties="Configuration=$(Configuration);RuntimeIdentifier=" />
    <ItemGroup>
      <PreviewHostFiles Include="$(PreviewHostOutput)/BarTenderPreviewHost.exe" />
      <PreviewHostFiles Include="$(PreviewHostOutput)/BarTenderPreviewHost.exe.config" Condition="Exists('$(PreviewHostOutput)/BarTenderPreviewHost.exe.config')" />
    </ItemGroup>
    <Error Condition="!Exists('$(PreviewHostOutput)/BarTenderPreviewHost.exe')" Text="BarTenderPreviewHost.exe was not built." />
    <Copy SourceFiles="@(PreviewHostFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPreviewHostToPublish" AfterTargets="Publish" DependsOnTargets="BuildPreviewHost">
    <Copy SourceFiles="@(PreviewHostFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
